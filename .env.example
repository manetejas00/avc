# TradingView embeds used by the existing market overview
VITE_TRADINGVIEW_WIDGET_MARKET_OVERVIEW=https://s3.tradingview.com/external-embedding/embed-widget-market-overview.js
VITE_TRADINGVIEW_WIDGET_TICKER_TAPE=https://s3.tradingview.com/external-embedding/embed-widget-ticker-tape.js
VITE_MFAPI_BASE_URL=https://api.mfapi.in/mf
VITE_UI_AVATARS_API_URL=https://ui-avatars.com/api/

# Server configuration
PORT=3000
DATABASE_URL=./data/avc.sqlite
# Set a strong random string in production.
JWT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Existing news enrichment and feeds
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
NEWS_API_URLS=

# Required in production for the Crypto Market Snapshot. Obtain a free demo key from CoinGecko.
COINGECKO_DEMO_API_KEY=
