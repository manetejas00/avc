Options -Indexes
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/(admin|ebook-admin-vault|v2)(/|\?|$)" private_page
  SetEnvIf Host "^test1\." private_page
  Header set X-Robots-Tag "noindex, nofollow" env=private_page
  # Revalidate the page so browsers discover new versioned bundles.
  SetEnvIf Request_URI "^/$|\.html$" html_page
  Header always set Cache-Control "no-cache, max-age=0, must-revalidate" env=html_page
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\. - [F,L]
  RewriteRule ^api/.*\.php$ - [L]
  RewriteRule ^api/ - [R=404,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>

<FilesMatch "^\.env">
  Order allow,deny
  Deny from all
</FilesMatch>

