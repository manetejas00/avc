Options -Indexes
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/(admin|v2)(/|\?|$)" private_page
  SetEnvIf Host "^test1\." private_page
  Header set X-Robots-Tag "noindex, nofollow" env=private_page
  # Revalidate the page so browsers discover new versioned bundles.
  SetEnvIf Request_URI "^/(?!assets/|images/|api/|dist/assets/|dist/images/|dist/api/)[^.]*$|\.html$" html_page
  Header always set Cache-Control "no-cache, max-age=0, must-revalidate" env=html_page
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Permanent 301 Redirect: test1.avinyacarefoundation.org -> https://avcdhanam.com (preserves path & query parameters)
  RewriteCond %{HTTP_HOST} ^test1\.avinyacarefoundation\.org$ [NC]
  RewriteRule ^(.*)$ https://avcdhanam.com/$1 [R=301,L,QSA]

  # 2. Canonical HTTPS & non-www enforcement for avcdhanam.com
  RewriteCond %{HTTP_HOST} ^www\.avcdhanam\.com$ [NC]
  RewriteRule ^(.*)$ https://avcdhanam.com/$1 [R=301,L,QSA]

  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^(www\.)?avcdhanam\.com$ [NC]
  RewriteRule ^(.*)$ https://avcdhanam.com/$1 [R=301,L,QSA]

  # Repository-root installs must never expose source, secrets, databases or archives.
  RewriteRule (^|/)\. - [F,L]
  # Serve the public preview route without exposing its source directory.
  RewriteRule ^v2/?$ dist/index.html [L]
  RewriteRule ^(src|services|tests|node_modules|scripts|db|netlify|v2)/ - [F,L,NC]
  RewriteRule \.(sqlite|sqlite-shm|sqlite-wal|db|zip|ts|tsx|mts|cjs|map|md|json|lock)$ - [F,L,NC]
  RewriteRule ^(server\.js|vite\.config\.[^/]+|.*\.config\.[^/]+)$ - [F,L,NC]
  # Hostinger's Git deployment publishes the repository root. Serve the Vite
  # production build and map its root-relative asset requests into dist/.
  RewriteRule ^$ dist/index.html [L]
  RewriteRule ^api/(.*)$ dist/api/$1 [L]
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]
  # Keep photos working for visitors with a previously cached home-page bundle.
  RewriteRule ^images/(.*)$ dist/images/$1 [L]
  RewriteRule ^(logo_[^/]+\.svg|logo\.jpg|robots\.txt|sitemap\.xml|preview\.html)$ dist/$1 [L]
  RewriteRule ^index\.html$ dist/index.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . dist/index.html [L]
</IfModule>

<FilesMatch "^\.env">
  Order allow,deny
  Deny from all
</FilesMatch>
